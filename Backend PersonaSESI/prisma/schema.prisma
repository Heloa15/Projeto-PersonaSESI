// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Alunos {
    id            Int             @id @default(autoincrement())
    rm            String          @unique
    nome          String
    serie         Int
    email         String          @unique
    cpf           String          @unique
    senha         String

    atividades    Atividades[]
    responsaveis  Responsaveis[]
}

model Coordenadores {
    id            Int             @id @default(autoincrement())
    nome          String
    email         String          @unique
    cpf           String          @unique
    senha         String

    professores   Professores[]
}

model Professores {
    id              Int             @id @default(autoincrement())
    nome            String
    telefone        String
    disciplina      String
    email           String          @unique
    cpf             String          @unique
    senha           String
    
    atividades      Atividades[]
    coordenador     Coordenadores   @relation(fields: [coordenadorId], references: [id])
    coordenadorId   Int
}

model Responsaveis {
    id            Int             @id @default(autoincrement())
    nome          String
    telefone      String
    email         String          @unique
    cpf           String          @unique
    senha         String
    aluno         Alunos          @relation(fields: [alunoId], references: [id])
    alunoId       Int
}

model Atividades {
  id             Int          @id @default(autoincrement())
  materia        String
  titulo         String
  descricao      String
  dataEntrega    String
  status         String       @default("Pendente")

  aluno          Alunos       @relation(fields: [alunoId], references: [id])
  alunoId        Int

  professor      Professores  @relation(fields: [professorId], references: [id])
  professorId    Int
}